APP_NAME=Raíces Conectadas API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api

FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

SUPABASE_URL=
SUPABASE_SECRET_KEY=

OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
CHAT_PRIMARY_LLM=openrouter/free
CHAT_FALLBACK_LLM=
CHAT_USE_FALLBACK=false
CHAT_TEMPERATURE=0.2
CHAT_TOP_P=0.8
CHAT_MAX_TOKENS=450
CHAT_TIMEOUT_MS=45000
# Imágenes ilustrativas (IA). Vacío = generación deshabilitada. Bucket público en Supabase Storage.
IMAGE_GENERATION_PROVIDER=
IMAGE_STORAGE_BUCKET=crop-illustrations
IMAGE_MAX_BYTES=3000000
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# EVA - Evaluaciones Agropecuarias (Socrata API)
EVA_API_HOST=www.datos.gov.co
EVA_RESOURCE_ID=uejq-wxrr
SOCRATA_APP_TOKEN=

# UPRA Geographic Reference (ArcGIS REST)
UPRA_GEO_HOST=geoservicios.upra.gov.co
UPRA_GEO_SERVICE_PATH=/arcgis/rest/services/referencia_geografica/referencia_geografica/MapServer
UPRA_DEPARTMENTS_LAYER=7
UPRA_MUNICIPALITIES_LAYER=8
UPRA_POPULATION_CENTERS_LAYER=9

# Cali Rural (optional)
CALI_RURAL_ENABLED=false

# Supabase Auth: clave publica (anon). Valida tokens de usuario contra /auth/v1/user.
SUPABASE_ANON_KEY=
